generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Product {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  slug              String   @unique
  sku               String   @unique
  brandId           String   @db.ObjectId
  brand             Brand    @relation(fields: [brandId], references: [id])
  categoryId        String   @db.ObjectId
  category          Category @relation(fields: [categoryId], references: [id])
  subcategory       String?
  images             String  @default("[]") // JSON string array of image URLs, first = primary
  price             Float
  mrp               Float
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  description       String   @default("")
  shortTagline      String   @default("")
  specifications    String   @default("[]") // JSON array of { name, value }
  options           String   @default("[]") // JSON array of { name, values: string[] }
  customPromotions  String   @default("[]") // JSON array of { label, style: "DARK" | "ACCENT" | "GRAY" }

  // manual promotional labels
  bestSeller  Boolean @default(false)
  bestPrice   Boolean @default(false)
  sale        Boolean @default(false)

  featured  Boolean @default(false)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
}

model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String    @unique
  description String    @default("")
  order       Int       @default(0)
  products    Product[]
}

model Brand {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  slug     String    @unique
  order    Int       @default(0)
  products Product[]
}

model Admin {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  email        String @unique
  passwordHash String
}

model Sale {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  date          DateTime
  productName   String
  costPrice     Float
  profit        Float
  finalPrice    Float
  customerName  String?
  customerPhone String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
}

model Settings {
  id                      String  @id @map("_id") @default("singleton")
  whatsappNumber          String  @default("910000000000")
  generalMessage          String  @default("Hi, I'd like to know more about your cricket equipment.")
  productEnquiryTemplate  String  @default("Hi, I'm interested in {name} ({brand}).\n\nListed price: ₹{price}\nMRP: ₹{mrp}\n{variant}SKU: {sku}\n\nPlease share availability and details.\nProduct link: {url}")
  questionTemplate        String  @default("Hi, I have a question about {name} ({brand}).\nProduct link: {url}")
  cardEnquiryTemplate     String  @default("Hi, I'm interested in {name} ({brand}).\n\nPrice: ₹{price}\n\nPlease share availability.")
  headerWhatsappEnabled   Boolean @default(true)
  footerWhatsappEnabled   Boolean @default(true)
  floatingWhatsappEnabled Boolean @default(true)
  announcementText        String  @default("FREE DELIVERY ON SELECTED ORDERS • WHATSAPP US FOR BULK ENQUIRIES • NEW CRICKET STOCK AVAILABLE")
  announcementColor       String  @default("#000000")
  lowStockThreshold       Int     @default(5)
  newArrivalDays          Int     @default(14)
  heavyDiscountThreshold  Int     @default(30)
}
